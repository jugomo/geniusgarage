{
    "compilerOptions": {
        "jsx": "react-jsx",
        "target": "ES2017",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "declaration": true,
        "types": ["vitest/globals"]
    },
    "include": [
        "src"
    ],
    "exclude": [
        "node_modules"
    ]
}